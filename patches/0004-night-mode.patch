diff --git a/mods/features/nightMode.js b/mods/features/nightMode.js
new file mode 100644
index 0000000..8d60dd8
--- /dev/null
+++ b/mods/features/nightMode.js
@@ -0,0 +1,43 @@
+// Night mode: a black overlay over the whole page (UI and video) between nightModeStartHour and
+// nightModeEndHour, for TVs whose lowest brightness is still too bright in a dark room.
+// The hour is read from the page's local clock (the TV's time zone, e.g. Europe/Paris), not UTC.
+import { configRead, configChangeEmitter } from '../config.js';
+
+let overlay = null;
+
+function inWindow(hour, start, end) {
+    if (start === end) return false;
+    return start < end ? hour >= start && hour < end : hour >= start || hour < end;
+}
+
+function ensureOverlay() {
+    if (overlay && overlay.isConnected) return overlay;
+    const host = document.body || document.documentElement;
+    if (!host) return null;
+    overlay = document.createElement('div');
+    const css = {
+        position: 'fixed', top: '0', left: '0', right: '0', bottom: '0',
+        background: '#000', 'pointer-events': 'none', 'z-index': '2147483647'
+    };
+    for (const name in css) overlay.style.setProperty(name, css[name], 'important');
+    host.appendChild(overlay);
+    return overlay;
+}
+
+function update() {
+    const active = configRead('enableNightMode') &&
+        inWindow(new Date().getHours(), configRead('nightModeStartHour'), configRead('nightModeEndHour'));
+    if (active) {
+        const el = ensureOverlay();
+        if (!el) return;
+        el.style.setProperty('opacity', String(configRead('nightModeStrength')), 'important');
+        el.style.setProperty('display', 'block', 'important');
+    } else if (overlay) {
+        overlay.style.setProperty('display', 'none', 'important');
+    }
+}
+
+configChangeEmitter.addEventListener('configChange', update);
+setInterval(update, 30000);
+update();
+if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', update);
